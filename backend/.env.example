# Application Environment
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# LinkedIn Direct HTTP Client Credentials
# LINKEDIN_SESSION_COOKIE: The 'li_at' cookie value from an authorized session
LINKEDIN_SESSION_COOKIE=your_li_at_cookie_value_here
# LINKEDIN_CSRF_TOKEN: Optional 'JSESSIONID' cookie value (e.g. "ajax:1234567890123456789")
LINKEDIN_CSRF_TOKEN=ajax:your_jsessionid_here
# LINKEDIN_USER_AGENT: Custom user agent string matching browser session
LINKEDIN_USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:154.0) Gecko/20100101 Firefox/154.0

# Network & Timeout Configuration
LINKEDIN_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=30
